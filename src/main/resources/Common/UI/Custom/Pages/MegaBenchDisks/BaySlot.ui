Button {
 Anchor: (Width: 76, Height: 76, Right: 8);
 Style: (Default: (Background: "../../Common/BlockSelectorSlotBackground.png"), Hovered: (Background: "../../Common/BlockSelectorSlotBackground.png"), Pressed: (Background: "../../Common/BlockSelectorSlotBackground.png"));
 ItemIcon #BayIcon { Anchor: (Full: 7); HitTestVisible: false; }
 Label #BayNumber { Anchor: (Right: 5, Bottom: 3, Width: 24, Height: 18); Style: (FontSize: 12, TextColor: #96a9be, HorizontalAlignment: End); }
 Group #Selected { Anchor: (Left: 2, Right: 2, Bottom: 1, Height: 3); Background: #e8cc81; Visible: false; }
}
